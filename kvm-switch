#!/usr/bin/env bash
# kvm-switch — hand the Alienware AW3926QW's keyboard/mouse (and, if needed,
# the screen) to the *other* computer. Linux side; the Mac uses mac/ (KVM Switch.app).
#
#   kvm-switch            toggle to the other machine (bind this to a hotkey)
#   kvm-switch status     show PBP state, active input, and who owns USB (--kv: key=value)
#   kvm-switch owner      "here" or "other": who owns the monitor's USB (no DDC)
#   kvm-switch pbp [toggle|on|off]
#                         PBP on/off. Turning it off also puts *this* machine full-screen.
#   kvm-switch input [toggle|linux|mac]
#                         full-screen input switch (DP <-> USB-C); refused while PBP is on
#
# How it works (DDC/CI, discovered on this monitor):
#   VCP 0xE9  PBP mode   0x00 = off, non-zero (0x24) = PBP on
#   VCP 0xE7  KVM        writing 0xFF00 toggles USB upstream (write-only)
#   VCP 0x60  input      0x0F = DisplayPort-1 (Linux), 0x1B = USB-C (Mac)
#
# PBP on  -> toggle the KVM only; both pictures stay on screen.
# PBP off -> switch the input to the other machine; the KVM follows it.
#   VCP 0xE9 is writable: 0x00 = PBP off (main input full-screen), 0x24 = PBP on.
set -euo pipefail

LINUX_INPUT=${KVM_LINUX_INPUT:-0x0f}   # DisplayPort-1
MAC_INPUT=${KVM_MAC_INPUT:-0x1b}       # USB-C
KVM_TOGGLE=0xff00
MODEL=${KVM_MODEL:-AW3926QW}

OS=$(uname -s)
log() { echo "kvm-switch: $*" >&2; }

notify() {
  case $OS in
    Linux)  command -v notify-send >/dev/null && notify-send -a kvm-switch -t 1500 "KVM" "$1" || true ;;
  esac
}

# --- backends ---------------------------------------------------------------
# vcp_get <code>  -> prints current value as a decimal integer
# vcp_set <code> <value>
if [[ $OS == Linux ]]; then
  command -v ddcutil >/dev/null || { log "ddcutil not found"; exit 1; }
  # Finding the monitor by model costs ~1s per call, so cache its I2C bus.
  BUS_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/kvm-switch.bus
  find_bus() {
    ddcutil detect --brief 2>/dev/null | awk -v m="$MODEL" '
      /I2C bus:/ { bus=$NF; sub(".*-", "", bus) } $0 ~ m { print bus; exit }'
  }
  BUS=${KVM_BUS:-$(cat "$BUS_CACHE" 2>/dev/null || true)}
  if [[ -z $BUS ]]; then
    BUS=$(find_bus); [[ -n $BUS ]] || { log "monitor $MODEL not found"; exit 1; }
    mkdir -p "$(dirname "$BUS_CACHE")"; echo "$BUS" >"$BUS_CACHE"
  fi
  # Fast DDC timing first; on failure re-detect the bus and retry at normal speed.
  ddc() {
    ddcutil --bus "$BUS" --sleep-multiplier 0.3 --noverify "$@" 2>/dev/null && return
    BUS=$(find_bus); echo "$BUS" >"$BUS_CACHE"
    ddcutil --bus "$BUS" --noverify "$@"
  }
  vcp_get() {
    # "VCP E9 CNC x00 xff x00 x24" (non-continuous) or "VCP 60 SNC x0f"
    local out; out=$(ddc getvcp "$1" --brief)
    local hi lo; read -r hi lo < <(awk '{ if (NF>=7) print $(NF-1), $NF; else print "x00", $NF }' <<<"$out")
    echo $(( 16#${hi#x} * 256 + 16#${lo#x} ))
  }
  vcp_set() { ddc setvcp "$1" "$2"; }
  OTHER_INPUT=$MAC_INPUT; OTHER_NAME=Mac; SELF_INPUT=$LINUX_INPUT
elif [[ $OS == Darwin ]]; then
  log "on macOS use the KVM Switch app (see README)"; exit 1
else
  log "unsupported OS: $OS"; exit 1
fi

# Does *this* machine currently own the monitor's USB hub?
owns_usb() {
  case $OS in
    Linux)  lsusb -d 0bda:5409 >/dev/null 2>&1 || lsusb -d 0bda:0409 >/dev/null 2>&1 ;;
  esac
}

input_name() {
  if (( $1 == LINUX_INPUT )); then echo Linux; elif (( $1 == MAC_INPUT )); then echo Mac; else printf '0x%02x' "$1"; fi
}

cmd_status() {
  local pbp input usb
  pbp=$(vcp_get e9); input=$(( $(vcp_get 60) & 0xff ))
  usb=$(owns_usb && echo here || echo other)
  if [[ ${1:-} == --kv ]]; then   # machine-readable, for the Plasma widget
    printf 'pbp=%s\ninput=%s\nusb=%s\n' "$( (( pbp != 0 )) && echo on || echo off)" "$(input_name "$input")" "$usb"
    return
  fi
  printf 'PBP:   %s (0x%02x)\n' "$( (( pbp != 0 )) && echo on || echo off)" "$pbp"
  printf 'Input: 0x%02x (%s)\n' "$input" "$(input_name "$input")"
  printf 'USB:   %s\n' "$([[ $usb == here ]] && echo "this machine ($OS)" || echo "the other machine")"
}

lock() {
  # Ignore key-repeat / double presses while a switch is in flight.
  exec 9>"${TMPDIR:-/tmp}/kvm-switch.$(id -u).lock"
  if command -v flock >/dev/null; then flock -n 9 || exit 0; fi
}

cmd_toggle() {
  lock
  local pbp
  pbp=$(vcp_get e9)
  if (( pbp != 0 )); then
    vcp_set e7 "$KVM_TOGGLE"
    notify "PBP: keyboard/mouse → $OTHER_NAME"
  else
    vcp_set 60 "$OTHER_INPUT"
    notify "Screen + keyboard → $OTHER_NAME"
  fi
}

cmd_pbp() {
  lock
  local want=${1:-toggle}
  if [[ $want == toggle ]]; then (( $(vcp_get e9) != 0 )) && want=off || want=on; fi
  case $want in
    on)  vcp_set e9 0x24; notify "PBP on" ;;
    off) vcp_set e9 0x00
         sleep 1
         vcp_set 60 "$SELF_INPUT"   # land full-screen on the machine you pressed it on
         notify "PBP off" ;;
    *) echo "usage: kvm-switch pbp [toggle|on|off]" >&2; exit 2 ;;
  esac
}

cmd_input() {
  lock
  if (( $(vcp_get e9) != 0 )); then
    log "PBP is on; input switching is disabled (use 'kvm-switch pbp off' first)"
    notify "Input switch disabled while PBP is on"; exit 3
  fi
  local target
  case ${1:-toggle} in
    toggle) (( ($(vcp_get 60) & 0xff) == LINUX_INPUT )) && target=$MAC_INPUT || target=$LINUX_INPUT ;;
    linux)  target=$LINUX_INPUT ;;
    mac)    target=$MAC_INPUT ;;
    *) echo "usage: kvm-switch input [toggle|linux|mac]" >&2; exit 2 ;;
  esac
  vcp_set 60 "$target"
  notify "Screen + keyboard → $(input_name "$target")"
}

case ${1:-toggle} in
  toggle) cmd_toggle ;;
  status) cmd_status "${2:-}" ;;
  owner)  owns_usb && echo here || echo other ;;   # no DDC; cheap enough to poll
  pbp)    cmd_pbp "${2:-}" ;;
  input)  cmd_input "${2:-}" ;;
  *) echo "usage: kvm-switch [toggle|status [--kv]|owner|pbp [toggle|on|off]|input [toggle|linux|mac]]" >&2; exit 2 ;;
esac
